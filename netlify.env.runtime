# Runtime-only environment variables for Netlify (under 4KB limit)
# Add these to Netlify Dashboard: Site Settings → Environment Variables
# Build-only variables are in netlify.toml
#
# IMPORTANT: This is a TEMPLATE file. Do NOT commit real secrets here.
# Copy this file to netlify.env.runtime.local for local testing only.
# For production, add these variables directly in Netlify Dashboard.

# Database / cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Auth / admin
ACCESS_TOKEN_SECRET=CHANGE_ME_32PLUS_CHARS
NEXTAUTH_SECRET=CHANGE_ME_32PLUS_CHARS
SESSION_SECRET=CHANGE_ME_32PLUS_CHARS
ADMIN_SESSION_SECRET=CHANGE_ME_64PLUS_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORT=CHANGE_ME
ADMIN_EMAIL=admin@clawking.klick
ADMIN_API_TOKEN=CHANGE_ME

# AI providers
AI_PROVIDER=deepseek
AI_PREFERRED=deepseek,gemini,openai
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email
RESEND_API_KEY=

# Security
SECURITY_CHECK_SECRET=

# API v1
V1_CHECK_INDICATOR_ENFORCE_AUTH=1
V1_CHECK_INDICATOR_SECRET=
V1_INTEL_REQUIRE_AUTH=0
V1_RUNBOOK_REAL_DATA=1
V1_RUNBOOK_REQUIRE_AUTH=1

# Stripe
STRIPE_PRICE_MSP=

# Rate limiting
MW_RL_ENABLED=1
